# Copy to .env and fill in. `.env` is git-ignored; never commit real values.

# GA4 measurement ID (public, ships in the page). Empty = no analytics tag.
PUBLIC_GA_ID=

# Cal.com booking page to embed / link from "Book a talk" (public), e.g. yaniv/30min
PUBLIC_CAL_LINK=

# Cal.com API key (server/build-time only — never prefixed PUBLIC_, never shipped to the browser).
# Only needed if we call the Cal.com API at build time (e.g. to list event types).
CAL_API_KEY=
