---
import { getCollection } from 'astro:content';
import { getEssays } from '../lib/essays';
const papers = await getCollection('papers');
const ripple = papers.find((p) => p.id.startsWith('financial-ripple-effect'))?.data;
const mushrooms = (await getEssays()).find((e) => e.id === 'mushrooms-not-ecosystems');
const items = [
  ripple && { eyebrow: 'Paper · IJPR 2023', title: ripple.title, image: ripple.image?.src, href: '/research#academic', cta: 'Read the paper' },
  mushrooms && { eyebrow: 'Essay', title: mushrooms.data.title, image: mushrooms.data.cover?.src, href: `/essays/${mushrooms.id}`, cta: 'Read the essay' },
  { eyebrow: 'Interactive', title: 'The Cambridge ecosystem model', image: '/pictures/multilayer_operationalisation.png', href: '/model', cta: 'Explore the model' },
].filter(Boolean) as { eyebrow: string; title: string; image?: string; href: string; cta: string }[];
---
<section class="section section--surface">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Selected work</p><h2>Three things to start with.</h2></div>
    <div class="featured">
      {items.map((it) => (
        <a class="card feat" href={it.href} data-reveal>
          {it.image && <img src={it.image} alt="" loading="lazy" width="640" height="400" />}
          <span class="eyebrow">{it.eyebrow}</span>
          <h3>{it.title}</h3>
          <span class="feat__cta">{it.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .featured { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .feat { display: flex; flex-direction: column; gap: 0.75rem; color: var(--color-text); }
  .feat img { aspect-ratio: 16/10; object-fit: cover; border-radius: var(--radius); background: var(--color-surface-2); }
  .feat h3 { font-size: 1.5rem; }
  .feat__cta { color: var(--color-accent); font-weight: 500; font-size: 0.9375rem; margin-top: auto; }
  @media (max-width: 800px) { .featured { grid-template-columns: 1fr; } }
</style>
