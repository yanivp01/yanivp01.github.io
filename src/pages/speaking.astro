---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LogoStrip from '../components/LogoStrip.astro';
import TalkCard from '../components/TalkCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Testimonial from '../components/Testimonial.astro';
import ClosingBand from '../components/ClosingBand.astro';
import { bookingHref } from '../lib/site';

const talks = (await getCollection('talks')).map((t) => t.data).sort((a, b) => b.year - a.year);
const videos = (await getCollection('videos')).map((v) => v.data);
const testimonials = (await getCollection('testimonials')).map((t) => t.data);
const logos = (await getCollection('logos')).map((l) => l.data);
const topics = [
  { title: 'AI in supply chains', text: 'The most-requested talk: what supply chains actually are, where AI helps, where it fails, and what autonomy levels mean in practice.' },
  { title: 'Complex networks in alternative finance', text: 'How risk and capital ripple through supply networks, venture ecosystems and financial infrastructure — and how to measure it.' },
  { title: 'Innovation ecosystems and AI-native ventures', text: 'Why ecosystems, not companies, are the unit of work; how Cambridge produces startups; what "AI-native" really requires.' },
];
const bookHref = bookingHref('Speaking enquiry');
const bookIsExternal = !bookHref.startsWith('mailto:');
---
<Base title="Speaking" description="Keynotes, panels and lectures by Dr. Yaniv Proselkov on AI, supply-chain finance and innovation ecosystems — delivered at LBS, Barclays, Imperial, the Alan Turing Institute and Cambridge Judge, in English or with Chinese interpretation." ogImage="/pictures/talk_lbs.jpg">
  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Speaking</p>
        <h1>Talks that make networks legible.</h1>
        <p class="small">Keynotes, panels and guest lectures for executives, investors, postgraduates and researchers. In English, or with live Chinese interpretation.</p>
        <p><a class="btn" href={bookHref} {...(bookIsExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Book a talk</a></p>
      </div>
      <div class="topics">{topics.map((t) => <div class="card"><h3>{t.title}</h3><p class="small">{t.text}</p></div>)}</div>
    </div>
  </section>
  <LogoStrip logos={logos} />
  <section class="section section--bg" id="talks">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Past talks</p><h2>Where I've spoken.</h2></div>
      <div class="list">{talks.map((talk) => <TalkCard talk={talk} />)}</div>
    </div>
  </section>
  <section class="section section--surface" id="videos">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Videos</p><h2>Watch.</h2></div>
      <div class="videos">{videos.map((v) => <VideoEmbed video={v} />)}</div>
    </div>
  </section>
  {testimonials.length > 0 && (
    <section class="section section--bg">
      <div class="wrap">
        <div class="section-head"><p class="eyebrow">What audiences say</p></div>
        <div class="quotes">{testimonials.map((t) => <Testimonial t={t} />)}</div>
      </div>
    </section>
  )}
  <ClosingBand heading="Have an event in mind?" />
</Base>
<style>
  .topics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .topics h3 { font-size: 1.375rem; margin-bottom: 0.5rem; }
  .list { display: grid; gap: 1.25rem; }
  .videos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
  @media (max-width: 800px) { .topics, .videos { grid-template-columns: 1fr; } }
</style>
