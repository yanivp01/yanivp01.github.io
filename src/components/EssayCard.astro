---
import type { Essay } from '../lib/essays';
import { formatDate } from '../lib/essays';
interface Props { essay: Essay; compact?: boolean }
const { essay, compact = false } = Astro.props;
const href = `/essays/${essay.id}`;
---
{compact ? (
  <a class="essay-row" href={href}>
    <span class="meta">{formatDate(essay.data.date)}</span>
    <span class="essay-row__title">{essay.data.title}</span>
    <span class="essay-row__summary">{essay.data.summary}</span>
  </a>
) : (
  <a class="card essay-card" href={href}>
    {essay.data.cover && <img src={essay.data.cover.src} alt={essay.data.cover.alt} loading="lazy" width="640" height="360" />}
    <span class="meta">{formatDate(essay.data.date)}</span>
    <h3>{essay.data.title}</h3>
    <p class="small">{essay.data.summary}</p>
    {essay.data.tags.length > 0 && <span class="tags">{essay.data.tags.map((t) => <span class="tag">{t}</span>)}</span>}
  </a>
)}
<style>
  .essay-card { display: flex; flex-direction: column; gap: 0.75rem; color: var(--color-text); }
  .essay-card img { aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); }
  .essay-card h3 { font-size: 1.5rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .tag { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: var(--radius-pill); background: var(--color-accent-soft); color: var(--color-accent); }
  .essay-row { display: grid; grid-template-columns: 9rem 1fr; gap: 0.25rem 1.5rem; padding: 1.25rem 0; border-top: 1px solid var(--color-line); color: var(--color-text); }
  .essay-row__title { font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-ink); }
  .essay-row__summary { grid-column: 2; color: var(--color-muted); font-size: 0.9375rem; }
  .essay-row:hover .essay-row__title { color: var(--color-accent); }
  @media (max-width: 600px) { .essay-row { grid-template-columns: 1fr; } .essay-row__summary { grid-column: 1; } }
</style>
