---
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-title" href="/">Dr. Yaniv Proselkov</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a class="btn btn--ink site-nav__cta" href={SITE.mailto('Enquiry via yapros.co.uk')}>Get in touch</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  const closeNav = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    document.body.classList.remove('nav-open');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeNav();
  });

  // Reset the mobile sheet state when the viewport grows past the breakpoint, so a resize
  // (or rotating a tablet) never leaves `nav-open`/`aria-expanded="true"` stuck from a smaller width.
  const desktopMq = window.matchMedia('(min-width: 801px)');
  desktopMq.addEventListener('change', (e) => { if (e.matches) closeNav(); });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.85); backdrop-filter: blur(10px); border-bottom: 1px solid var(--color-line); }
  .site-header__row { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .site-title { font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-ink); letter-spacing: -0.005em; }
  .site-nav ul { list-style: none; display: flex; align-items: center; gap: 1.75rem; }
  .site-nav a { font-size: 0.875rem; font-weight: 500; color: var(--color-text); padding-bottom: 2px; border-bottom: 2px solid transparent; }
  .site-nav a:hover { color: var(--color-ink); }
  .site-nav a[aria-current="page"] { border-bottom-color: var(--color-accent); color: var(--color-ink); }
  .site-nav__cta { height: 38px; padding: 0 1.125rem; border-bottom: 0 !important; color: #fff !important; }
  .nav-toggle { display: none; width: 44px; height: 44px; background: none; border: 0; cursor: pointer; flex-direction: column; justify-content: center; gap: 5px; }
  .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--color-ink); margin: 0 auto; }
  @media (max-width: 800px) {
    .nav-toggle { display: flex; }
    /* `.site-header` is `backdrop-filter`ed, which makes it the containing block for fixed
       descendants — a `position: fixed` sheet here collapses to the header's own height. The
       header is sticky and body scroll is locked while open, so an absolutely-positioned sheet
       anchored to the header's bottom edge covers the same area without that trap. */
    .site-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; height: calc(100dvh - 72px); overflow-y: auto; background: var(--color-surface); padding: 2rem 1.5rem; }
    .site-nav.is-open { display: block; }
    .site-nav ul { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .site-nav a { font-size: 1.25rem; }
  }
</style>

<style is:global>
  body.nav-open { overflow: hidden; }
</style>
