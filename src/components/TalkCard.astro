---
import type { Talk } from '../content/schemas';
interface Props { talk: Talk }
const { talk } = Astro.props;
const kindLabel = { keynote: 'Keynote', panel: 'Panel', lecture: 'Lecture', conference: 'Conference' }[talk.kind];
---
<article class="card talk">
  {talk.image && <img src={talk.image.src} alt={talk.image.alt} loading="lazy" width="640" height="360" />}
  <div class="talk__body">
    <p class="talk__meta"><span class="badge">{kindLabel}</span><span class="meta">{talk.year}</span></p>
    <h3>{talk.title}</h3>
    <p class="meta">{talk.byline}</p>
    <p class="small">{talk.blurb}</p>
    {talk.links.length > 0 && <p class="talk__links">{talk.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label ?? 'Link'} ↗</a>)}</p>}
  </div>
</article>
<style>
  .talk { display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; }
  .talk img { aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); }
  .talk__meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
  .badge { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: var(--radius-pill); background: var(--color-accent-soft); color: var(--color-accent); }
  .talk h3 { font-size: 1.375rem; margin-bottom: 0.375rem; }
  .talk__links { margin-top: 0.75rem; display: flex; gap: 1rem; font-size: 0.875rem; font-weight: 500; }
  @media (max-width: 700px) { .talk { grid-template-columns: 1fr; } }
</style>
