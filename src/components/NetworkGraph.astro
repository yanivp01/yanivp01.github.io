---
import '../styles/network.css';
interface Props { mode: 'hero' | 'full' }
const { mode } = Astro.props;
---
<div class:list={['network', `network--${mode}`]} data-network={mode}>
  <div class="network__3d" aria-hidden="true"></div>
  {mode === 'full' && <aside class="network__panel node-star" aria-label="Node-star view" tabindex="-1"></aside>}
  <div class="network__2d"></div>
  <noscript><p class="small">Enable JavaScript to explore the interactive ecosystem model.</p></noscript>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-network]');
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const webgl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();

  roots.forEach((root) => {
    const mode = root.dataset.network as 'hero' | 'full';
    const el3d = root.querySelector<HTMLElement>('.network__3d')!;
    const el2d = root.querySelector<HTMLElement>('.network__2d')!;
    const panel = root.querySelector<HTMLElement>('.network__panel');

    let mounted2D = false;
    const mount2D = async () => {
      if (mounted2D) return;
      mounted2D = true;
      const { mountNetwork2D } = await import('../lib/network-2d');
      mountNetwork2D(el2d, { interactive: mode === 'full' });
    };
    // 2D-only path: reduced motion, no WebGL, or the 3D island failed to load/mount.
    // The 2D port carries its own node-star view, so the 3D panel is dropped.
    const fallback = () => { el3d.remove(); panel?.remove(); root.classList.add('network--fallback'); return mount2D(); };

    if (!(motionOK && webgl)) { fallback(); return; }

    const start = async () => {
      try {
        const { mountNetwork3D } = await import('../lib/network-3d');
        if (mode === 'hero') {
          // Hero graph: flat ink nodes (no layer colour-coding — that's a /model-only detail),
          // no clicks, still pointer-reactive (drag rotates; see network-3d's enableRotate).
          await mountNetwork3D(el3d, { autoRotate: true, interactive: false, nodeColor: () => '#0e0e10' });
          return;
        }

        // Full mode: 3D graph + node-star panel. Node/background clicks and the panel's own
        // controls all route through select(), which keeps graph highlight and panel in sync.
        const { renderNodeStar } = await import('../lib/node-star');
        let current: string | null = null;
        let handle: Awaited<ReturnType<typeof mountNetwork3D>> | null = null;
        const select = (id: string | null) => {
          current = id;
          handle?.select(id);
          if (panel) {
            // Re-rendering drops whichever panel button was just activated; keep keyboard focus
            // inside the panel when the selection came from it (never steal focus from the canvas).
            const fromPanel = panel.contains(document.activeElement);
            renderNodeStar(panel, id, { onSelect: select });
            if (fromPanel) (panel.querySelector<HTMLElement>('.node-star__close') ?? panel).focus({ preventScroll: true });
          }
          root.classList.toggle('network--selected', !!id);
        };
        if (panel) renderNodeStar(panel, null, { onSelect: select });
        handle = await mountNetwork3D(el3d, {
          autoRotate: true,
          interactive: true,
          onNodeClick: (id) => select(id && id === current ? null : id),
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) select(null); });
      } catch {
        await fallback();
      }
    };
    if (mode === 'hero' && 'requestIdleCallback' in window) (window as any).requestIdleCallback(start); else start();
  });
</script>

<style>
  .network { position: relative; }
  .network--hero { height: 460px; }
  .network--hero .network__3d { position: absolute; inset: 0; }
  .network--hero .network__2d { display: none; }
  .network--fallback .network__2d { display: block; }

  /* Full mode: canvas + node-star panel side by side, stacking on narrow screens. */
  .network--full { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 1.25rem; align-items: start; margin-bottom: 2rem; }
  .network--full .network__3d { height: 560px; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); overflow: hidden; }
  .network--full:not(.network--fallback) .network__2d { display: none; } /* 2D UI only mounts on the fallback path */
  .network--full.network--fallback { display: block; }
  @media (max-width: 900px) {
    .network--full { grid-template-columns: minmax(0, 1fr); }
    .network--full .network__3d { height: 440px; }
  }

  /* Node-star panel (rendered by src/lib/node-star.ts). Global selectors below are :global so the
     dynamically created children pick them up. */
  .network__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    min-height: 220px;
    max-height: 560px;
    overflow: auto;
    font-size: 0.875rem;
  }
  .network__panel :global(.node-star__eyebrow) { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); margin: 0 0 0.5rem; }
  .network__panel :global(.node-star__prompt) { color: var(--color-muted); margin: 0 0 1rem; }
  .network__panel :global(.node-star__index) { display: grid; gap: 1rem; }
  .network__panel :global(.node-star__index-group h4) { display: flex; align-items: center; gap: 0.4rem; }
  .network__panel :global(.node-star__index-list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .network__panel :global(.node-star__index-btn) { display: flex; align-items: baseline; gap: 0.5rem; width: 100%; text-align: left; font: inherit; font-size: 0.8rem; color: var(--color-text); background: transparent; border: 0; border-radius: var(--radius); padding: 0.3rem 0.35rem; cursor: pointer; }
  .network__panel :global(.node-star__index-btn:hover) { background: var(--color-surface-2); color: var(--color-ink); }
  .network__panel :global(.node-star__index-dot) { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; align-self: center; }
  .network__panel :global(.node-star__index-id) { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-muted); }
  .network__panel :global(.node-star__head) { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .network__panel :global(.node-star__id) { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--color-muted); margin: 0 0 0.2rem; }
  .network__panel :global(.node-star__label) { font-size: 1.25rem; line-height: 1.15; margin: 0 0 0.5rem; }
  .network__panel :global(.node-star__chip) { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.15rem 0.6rem; border-radius: var(--radius-pill); font-size: 0.75rem; color: var(--color-ink); background: color-mix(in srgb, var(--chip) 14%, var(--color-surface)); border: 1px solid color-mix(in srgb, var(--chip) 45%, var(--color-line)); }
  .network__panel :global(.node-star__chip-dot) { width: 8px; height: 8px; border-radius: 50%; background: var(--chip); }
  .network__panel :global(.node-star__close) { flex-shrink: 0; font: inherit; font-size: 0.8rem; color: var(--color-muted); background: transparent; border: 1px solid var(--color-line); border-radius: var(--radius-pill); padding: 0.25rem 0.7rem; cursor: pointer; }
  .network__panel :global(.node-star__close:hover) { color: var(--color-ink); border-color: var(--color-accent); }
  .network__panel :global(.node-star__cols) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-line); }
  .network__panel :global(.node-star__list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .network__panel :global(.node-star__list li) { font-size: 0.78rem; line-height: 1.35; color: var(--color-text); padding-left: 0.6rem; border-left: 2px solid var(--color-line-2); }
  .network__panel :global(.node-star__flows) { display: grid; gap: 1rem; padding-top: 1rem; }
  .network__panel :global(.node-star__edges) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .network__panel :global(.node-star__none) { color: var(--color-muted); font-size: 0.8rem; }
  .network__panel :global(.node-star__edge) { display: flex; align-items: baseline; gap: 0.5rem; width: 100%; text-align: left; font: inherit; font-size: 0.8rem; color: var(--color-accent); background: transparent; border: 0; border-radius: var(--radius); padding: 0.25rem 0.35rem; cursor: pointer; }
  .network__panel :global(.node-star__edge:hover) { background: var(--color-surface-2); color: var(--color-ink); }
  .network__panel :global(.node-star__edge-dot) { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; align-self: center; }
  .network__panel :global(.node-star__edge-node) { font-weight: 500; }
  .network__panel :global(.node-star__edge-label) { color: var(--color-muted); }
  @media (prefers-reduced-motion: no-preference) {
    .network__panel :global(.node-star__close),
    .network__panel :global(.node-star__edge),
    .network__panel :global(.node-star__index-btn) { transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease; }
  }
</style>
