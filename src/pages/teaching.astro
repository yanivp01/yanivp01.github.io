---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourseCard from '../components/CourseCard.astro';
import ClosingBand from '../components/ClosingBand.astro';
import { SITE } from '../lib/site';
const courses = (await getCollection('courses')).map((c) => c.data);
const deliveries = [
  { title: 'Venture Scholar Studio — Cohort 0 (2025)', text: 'Two months co-delivered with Nuray Salina as one-week sprints across ideation, market evaluation, customer discovery, value capture, finance, leadership, scaling and pitching — each anchored in two live startups. Students from Iceland, the UK and Kazakhstan.', image: { src: '/pictures/yaniv and nuray teaching vss class.jpg', alt: 'Venture Scholar Studio Cohort 0 video call with the teaching team and students' } },
  { title: 'Engineering Mathematics in Business', text: 'Lectures and workshops for executives, students, academics and private companies, delivered in English with live Chinese interpretation — most recently Complex Networks in Financial Infrastructure.', image: { src: '/pictures/yaniv teaching online class.jpg', alt: 'Online lecture to a Chinese audience with a live interpreter' } },
  { title: 'Cambridge Judge Business School', text: 'Guest lectures on AI, entrepreneurship and innovation ecosystems to an audience of around twenty-five students.', image: { src: '/pictures/yaniv teaching class at judge business school.jpg', alt: 'Lecture at Judge Business School, Cambridge' } },
];
---
<Base title="Teaching" description="Guest lectures, executive workshops and full courses on AI in supply chains, complex networks in finance, entrepreneurship and innovation ecosystems — for executives, postgraduates and researchers, in English and Chinese." ogImage="/pictures/yaniv teaching class at judge business school.jpg">
  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Teaching</p>
        <h1>Courses at the intersection of complex systems, technology and business.</h1>
        <p class="small">Guest lectures, executive workshops and full courses. Existing material can be delivered as-is; bespoke programmes are equally welcome — any permutation of complex business systems, technology and mathematics can be built from the portfolio.</p>
        <p><a class="btn" href={SITE.mailto('Teaching enquiry')}>Enquire about a course</a></p>
      </div>
      <div class="courses">{courses.map((course) => <CourseCard course={course} />)}</div>
    </div>
  </section>
  <section class="section section--bg">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Recently delivered</p><h2>In the room and on the call.</h2></div>
      <div class="deliveries">
        {deliveries.map((d) => (
          <article class="card delivery">
            <img src={d.image.src} alt={d.image.alt} loading="lazy" width="640" height="360" />
            <h3>{d.title}</h3>
            <p class="small">{d.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ClosingBand heading="Commissioning a lecture, workshop or course?" />
</Base>
<style>
  .courses { display: grid; gap: 2rem; }
  .deliveries { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .delivery { display: flex; flex-direction: column; gap: 0.75rem; }
  .delivery img { aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); }
  .delivery h3 { font-size: 1.375rem; }
  @media (max-width: 800px) { .deliveries { grid-template-columns: 1fr; } }
</style>
