---
import type { Testimonial } from '../content/schemas';
interface Props { t: Testimonial }
const { t } = Astro.props;
---
<figure class="quote">
  <blockquote>“{t.quote}”</blockquote>
  <figcaption>{t.name} — {t.role}, {t.org}</figcaption>
</figure>
<style>
  .quote blockquote { font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; line-height: 1.35; color: var(--color-ink); }
  .quote figcaption { margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-muted); }
</style>
